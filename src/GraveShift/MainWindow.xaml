<Window x:Class="GraveShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GraveShift" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/GraveShift.ico">
    <Border x:Name="Root" Background="{StaticResource Bg}" Padding="24,20,16,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="532"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Now -->
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="BigKelvin" FontSize="44" FontWeight="Light" Text="3400K"/>
                        <TextBlock x:Name="Status" FontSize="15" Foreground="{StaticResource Dim}" Text="Sunset in 2 hours"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="Clock" FontSize="28" FontWeight="Light" HorizontalAlignment="Right" Text="21:04"/>
                        <TextBlock x:Name="SunLine" Style="{StaticResource Small}" HorizontalAlignment="Right" Text="☀ 07:12  ☾ 16:31"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="Banner" Visibility="Collapsed" Background="#3B2A1A" CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#FFD2A8"/>
                </Border>

                <!-- Day graph: the colour over the next 24 hours, now in the middle -->
                <Border x:Name="GraphFrame" Background="{StaticResource Panel}" CornerRadius="12" Margin="0,16,0,0">
                    <Canvas x:Name="Graph" Height="150"/>
                </Border>

                <!-- Colours -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Daytime" VerticalAlignment="Center"/>
                    <Slider x:Name="DaySlider" Grid.Column="1" Style="{StaticResource TempSlider}" VerticalAlignment="Center" AutomationProperties.Name="Daytime colour"/>
                    <TextBlock x:Name="DayValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Sunset" VerticalAlignment="Center"/>
                    <Slider x:Name="NightSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource TempSlider}" VerticalAlignment="Center" AutomationProperties.Name="Sunset colour"/>
                    <TextBlock x:Name="NightValue" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Bedtime" VerticalAlignment="Center"/>
                    <Slider x:Name="LateSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource TempSlider}" VerticalAlignment="Center" AutomationProperties.Name="Bedtime colour"/>
                    <TextBlock x:Name="LateValue" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Preset and wake time -->
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Preset" VerticalAlignment="Center" Width="80"/>
                        <ComboBox x:Name="PresetBox" Width="170" AutomationProperties.Name="Preset"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Wake at" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="WakeDown" Content="−" Padding="10,3" AutomationProperties.Name="Earlier wake time"/>
                        <TextBlock x:Name="WakeText" Width="76" TextAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        <Button x:Name="WakeUp" Content="+" Padding="10,3" AutomationProperties.Name="Later wake time"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PresetInfo" Style="{StaticResource Small}" Margin="80,4,0,0"/>

                <TextBlock x:Name="Footer" Style="{StaticResource Small}" Margin="0,22,0,0"
                           Text="Closing this window keeps GraveShift running in the tray. Right-click the tray icon for more."/>
            </StackPanel>

            <!-- Tab on the right edge that slides Options open and shut -->
            <Button x:Name="OptionsToggle" Grid.Column="1" Margin="16,0,0,0" Cursor="Hand" VerticalAlignment="Stretch"
                    AutomationProperties.Name="Show options" ToolTip="Options">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tab" Width="30" CornerRadius="8" Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="Chevron" Text="›" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="OPTIONS" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#2A2538"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="open">
                                <Setter TargetName="Chevron" Property="Text" Value="‹"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Options -->
            <Border x:Name="OptionsPanel" Grid.Column="2" Width="330" Margin="16,0,8,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Options" FontSize="22" FontWeight="Light" Margin="0,6,0,10"/>

                    <TextBlock Text="Location" FontWeight="SemiBold"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Latitude" VerticalAlignment="Center"/>
                        <TextBox x:Name="LatBox" Grid.Column="1" AutomationProperties.Name="Latitude"/>
                        <TextBlock Grid.Row="1" Text="Longitude" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox x:Name="LonBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" AutomationProperties.Name="Longitude"/>
                        <Button x:Name="SaveLocation" Grid.Column="2" Content="Save" Margin="8,0,0,0" HorizontalAlignment="Left"/>
                        <Button x:Name="FindMe" Grid.Row="1" Grid.Column="2" Content="Ask Windows" Margin="8,6,0,0" HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock x:Name="LocationInfo" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Decimal degrees: north and east are positive, south and west are negative."/>

                    <TextBlock Text="Transitions" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <ComboBox x:Name="SpeedBox" Margin="0,6,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Transition speed">
                        <ComboBoxItem Tag="slow" Content="Slow: about an hour, like the sky"/>
                        <ComboBoxItem Tag="medium" Content="Medium: 20 minutes"/>
                        <ComboBoxItem Tag="veryfast" Content="Very fast: 20 seconds"/>
                    </ComboBox>

                    <CheckBox x:Name="StartupBox" Content="Start when I sign in to Windows" Margin="0,14,0,0"/>
                    <CheckBox x:Name="FullscreenBox" Content="Turn off for full-screen apps"/>

                    <TextBlock x:Name="RangeInfo" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <Button x:Name="RangeButton" Content="Unlock" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="OverlayButton" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverlayInfo" TextWrapping="Wrap"/>
                    </DockPanel>

                    <TextBlock Text="Hotkeys" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" LineHeight="18" TextWrapping="Wrap"
                               Text="Alt+End  turn off for an hour, or back on&#10;Alt+PgUp / PgDn  brighter / dimmer&#10;Alt+Shift+PgUp / PgDn  cooler / warmer until the next change"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
